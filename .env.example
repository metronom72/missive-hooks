# The "Signature secret" from the Missive rule action. Without it the service
# refuses to boot -- a webhook consumer that cannot verify signatures is an
# open endpoint, not a degraded one.
MISSIVE_SIGNATURE_SECRET=

MISSIVE_API_TOKEN=
MISSIVE_API_BASE_URL=https://public.missiveapi.com/v1

REDIS_URL=redis://127.0.0.1:6379/0

# Shared label ids, one per rule type. The suffix is the rule's own `type`
# upcased, so adding a rule needs a variable and no code.
MISSIVE_LABEL_LABEL_CHANGE=
MISSIVE_LABEL_INCOMING_EMAIL=
